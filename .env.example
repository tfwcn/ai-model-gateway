# AI Model Gateway - 环境变量配置文件
# 复制此文件为 .env 并填入真实的API密钥

# ModelScope API 密钥
MODELSCOPE_API_KEY=your-modelscope-api-key-here

# OpenRouter API 密钥  
OPENROUTER_API_KEY=your-openrouter-api-key-here

# OpenAI API 密钥（如果启用OpenAI平台）
OPENAI_API_KEY=your-openai-api-key-here

# Azure OpenAI API 密钥（如果启用Azure平台）
AZURE_API_KEY=your-azure-api-key-here

# 其他平台的API密钥可以按需添加
# PLATFORM_NAME_API_KEY=your-api-key-here

# Gateway 管理密钥（连接管理台 /admin/* 与 /metrics；为空则管理接口关闭）
GATEWAY_API_KEY=your-gateway-api-key-here

# 用户级密钥库（用户密钥在管理台「用户密钥」页新增/删除，明文只在创建时显示一次）
# API_KEYS_DB_PATH=data/api_keys.db

# Redis 配置 (用于 Responses API 会话状态管理)
REDIS_URL=redis://localhost:6379
RESPONSES_SESSION_TTL=86400

# 日志配置 (简化版)
# DEBUG=true                    # 启用 DEBUG 级别日志 (默认 INFO)
# ENABLE_CONSOLE_LOGS=false     # 禁用控制台输出 (默认 true)
# LOG_DIR=logs                  # 日志目录 (默认 logs/)
# LOG_MAX_STR_LEN=500           # 日志中字符串最大长度，超长截断 (默认 500)

# 流式转发 (可选)
# SSE_KEEPALIVE_INTERVAL=1.0        # 上游首块前的静默期，每隔该秒下发一条 SSE 注释；0 关闭心跳
# SSE_DONE_DRAIN_TIMEOUT=0.5        # 转发完 [DONE] 后，为可能跟在后面的 usage 尾片再多等的秒数

# 审计与用量统计 (一次上游调用一行，写入 SQLite)
# 优先级：默认值 < 这里的 AUDIT_* < models.yaml 顶层 audit: 段
# AUDIT_ENABLED=true                  # 总开关，关闭后转发热路径零开销
# AUDIT_DB_PATH=data/audit.db         # 审计库路径
# AUDIT_RETENTION_DAYS=30             # 审计明细保留天数（启动时与运行中定期清理）；全量日用量永久保留
# AUDIT_QUEUE_SIZE=10000              # 内存队列容量，满了丢弃最旧行并计数
# AUDIT_BATCH_SIZE=200                # 单次写库的最大行数
# AUDIT_FLUSH_INTERVAL=2.0            # 后台刷盘间隔（秒）
# AUDIT_RECORD_FAILED_ONLY=false      # 只记失败尝试，省磁盘但看不到用量
# AUDIT_INCLUDE_REQUEST_META=false    # 是否记录消息条数；任何情况都不记录消息内容
# AUDIT_PROMETHEUS=true               # 审计落库时同步喂 Prometheus
# METRICS_LABEL_MODEL=false           # Prometheus 是否带 model 标签（爬虫模式下基数大，默认关）

# 管理接口与管理台 (/admin/* 与 /metrics 都需要 GATEWAY_API_KEY)
# ADMIN_UI_ENABLED=true               # 管理台前端 /admin/ui，false 则返回 404
# CONFIG_API_ENABLED=true             # 配置读写接口 /admin/config/*，false 则不提供
# CONFIG_BACKUP_DIR=data/config_backups   # 每次写盘前的自动备份目录
# MODEL_CONFIG_FILE=models.yaml       # 命令行默认读取的配置文件